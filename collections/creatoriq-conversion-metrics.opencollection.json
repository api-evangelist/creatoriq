{
  "opencollection": "1.0.0",
  "info": {
    "name": "Conversion Metrics API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Global Conversion Metrics Configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Conversion Metrics Configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.creatoriq.com/crm/v1/api/conversions",
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns a list of defined conversion metrics for the current partner.\n"
        },
        {
          "info": {
            "name": "Retrieve Conversion Metric Configuration by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.creatoriq.com/crm/v1/api/conversion/:conversionMetricId",
            "params": [
              {
                "name": "conversionMetricId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the conversion metric."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns the configuration for a specific conversion metric\n"
        },
        {
          "info": {
            "name": "Update Existing Conversion Metric",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://apis.creatoriq.com/crm/v1/api/conversion/:conversionMetricId",
            "params": [
              {
                "name": "conversionMetricId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the conversion metric."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Updates the configuration for a specific conversion metric.\n"
        }
      ]
    },
    {
      "info": {
        "name": "Campaign Conversion Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
