                "description": "The unique identifier for the campaign."
              },
              {
                "name": "trackingLinkId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the tracking link."
              },
              {
                "name": "conversionMetricName",
                "value": "",
                "type": "path",
                "description": "The name of the conversion metric."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve a specific conversion metric by its name for a given campaign and tracking link.\nThis endpoint is useful for fetching detailed information about a specific conversion metric.\n"
        },
        {
          "info": {
            "name": "Get All Conversion Metrics by Tracking Link ID",
            "type": "http"
