        },
        {
          "info": {
            "name": "Get Conversion Metrics by Publisher (Post-Level)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.creatoriq.com/crm/v1/api/campaign/:campaignId/publisher/:publisherId/conversionPostMetrics",
            "params": [
              {
                "name": "campaignId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the campaign."
