            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns a list of conversion metric names for a specific campaign.\n"
        },
        {
          "info": {
            "name": "Upsert Conversion Metrics for a Campaign",
            "type": "http"
