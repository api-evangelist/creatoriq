              {
                "name": "postId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the post."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
