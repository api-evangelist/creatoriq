              {
                "name": "trackingLinkId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the tracking link."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve all conversion metrics associated with a specific tracking link for a given campaign.\nThis endpoint is useful for fetching a comprehensive list of conversion metrics related to a tracking link.\n"
        },
        {
          "info": {
            "name": "Get Conversion Metrics for a Specific Post",
            "type": "http"
