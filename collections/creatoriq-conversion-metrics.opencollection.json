          "http": {
            "method": "POST",
            "url": "https://apis.creatoriq.com/crm/v1/api/campaign/:campaignId/conversionMetrics",
            "params": [
              {
                "name": "campaignId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the campaign."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Upsert Conversion Metrics for a Campaign.\n"
        },
        {
          "info": {
            "name": "Get Conversion Metric by Name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.creatoriq.com/crm/v1/api/campaign/:campaignId/tracking-link/:trackingLinkId/conversionMetric/:conversionMetricName",
            "params": [
              {
                "name": "campaignId",
                "value": "",
