            "description": {
              "content": "Provides the list of published notes added to a one-sheet or to a one-sheet publisher. <br/>\nGet Notes API endpoint returns the data only if it is added via API. The comments/notes left via the UI are not available via these endpoints.\n",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "crm",
                "v1",
                "api",
                "notes",
                ":entity",
                ":entityId"
              ],
