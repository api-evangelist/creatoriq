                "creatoriq",
                "com"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "entity",
                  "description": "(Required) Entity type"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "entityId",
                  "description": "(Required) Unique entity id.\nEntity ID should be taken accordingly to `entity` type:\n* `onesheet-publisher` - the `SalesSheetsPublisherId` field from the response of Reports => OneSheet => Get OneSheet Builder: `/crm/v1/api/view?view=OneSheetBuilder/OneSheetBuilder`\n"
                }
              ]
            },
